{
  "name": "poc-expire-snapshots",
  "virtualClusterId": "brtw9ztup2y01wok6x8r2bsmr",
  "executionRoleArn": "arn:aws:iam::910556394401:role/bs-analytics-emr-on-eks-irsa",
  "releaseLabel": "emr-7.9.0-latest",
  "tags": {
    "Vendor": "Devotica",
    "cost-center": "emr-eks-prod",
    "workload": "iceberg-poc"
  },
  "jobDriver": {
    "sparkSubmitJobDriver": {
      "entryPoint": "s3://emr-migration-poc/scripts/poc_expire_snapshots.py",
      "sparkSubmitParameters": "--jars s3://emr-migration-poc/jars/s3-tables-catalog-for-iceberg-runtime-0.1.8.jar"
    }
  },
  "configurationOverrides": {
    "applicationConfiguration": [
      {
        "classification": "spark-defaults",
        "properties": {
          "spark.executor.instances": "1",
          "spark.executor.memory": "4G",
          "spark.executor.cores": "2",
          "spark.driver.memory": "2G",
          "spark.driver.cores": "1",

          "spark.kubernetes.driver.podTemplateFile": "s3://emr-migration-poc/podtemplates/driver-podtemplate.yaml",
          "spark.kubernetes.executor.podTemplateFile": "s3://emr-migration-poc/podtemplates/driver-podtemplate.yaml",

          "spark.kubernetes.driver.serviceAccountName": "emr-sa",
          "spark.kubernetes.executor.serviceAccountName": "emr-sa",
          "spark.kubernetes.driver.label.cost-center": "emr-eks-prod",
          "spark.kubernetes.executor.label.cost-center": "emr-eks-prod",

          "spark.log.level": "INFO",

          "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
          "spark.sql.catalog.s3tablescatalog/bs-iot-tables-poc": "org.apache.iceberg.spark.SparkCatalog",
          "spark.sql.catalog.s3tablescatalog/bs-iot-tables-poc.catalog-impl": "software.amazon.s3tables.iceberg.S3TablesCatalog",
          "spark.sql.catalog.s3tablescatalog/bs-iot-tables-poc.warehouse": "arn:aws:s3tables:ap-south-1:910556394401:bucket/bs-iot-tables-poc",
          "spark.sql.defaultCatalog": "s3tablescatalog/bs-iot-tables-poc",
          "spark.hadoop.fs.s3a.aws.credentials.provider": "com.amazonaws.auth.WebIdentityTokenCredentialsProvider",

          "spark.driver.extraJavaOptions": "-Dsoftware.amazon.s3tables.shaded.awssdk.http.service.impl=software.amazon.s3tables.shaded.awssdk.http.urlconnection.UrlConnectionSdkHttpService",
          "spark.executor.extraJavaOptions": "-Dsoftware.amazon.s3tables.shaded.awssdk.http.service.impl=software.amazon.s3tables.shaded.awssdk.http.urlconnection.UrlConnectionSdkHttpService"
        }
      }
    ],
    "monitoringConfiguration": {
      "cloudWatchMonitoringConfiguration": {
        "logGroupName": "/emr-on-eks/bs-analytics",
        "logStreamNamePrefix": "poc-expire-snapshots"
      },
      "s3MonitoringConfiguration": {
        "logUri": "s3://emr-migration-poc/emr-eks-logs/"
      }
    }
  }
}
